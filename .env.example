# Environment variables (placeholder values only — safe to commit)
# Copy to .env.local and fill in real values. .env* is gitignored.
#
# Everything with the EXPO_PUBLIC_ prefix is embedded in the shipped app
# bundle and is readable by anyone who downloads it. Only publishable keys
# belong here. Service-role keys, admin credentials, database URLs, and API
# secrets go on a server or in EAS Secrets — never in this file.
#
# See docs/AUTH.md for the provider integration steps.

# Which authentication provider to use: none | supabase | clerk | firebase
# Leaving this as 'none' runs the development placeholder, which does not
# verify passwords and is blocked from production builds.
EXPO_PUBLIC_AUTH_PROVIDER=none

# Supabase
# EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Clerk
# EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your-key

# Firebase
# EXPO_PUBLIC_FIREBASE_API_KEY=your-api-key
# EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
# EXPO_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
