# Environment variables (placeholder values only — safe to commit)
# Copy to .env.local and fill in real values. .env* is gitignored.
#
# Everything with the EXPO_PUBLIC_ prefix is embedded in the shipped app
# bundle and is readable by anyone who downloads it. Only publishable keys
# belong here. Service-role keys, admin credentials, and API secrets go on
# a server or in EAS Secrets — never in this file.

# supabase | none | clerk | firebase
# If URL + anon key are set, Supabase Auth is used even when this is "none".
EXPO_PUBLIC_AUTH_PROVIDER=supabase

# Supabase — publishable values only. Never put the service-role key here.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Clerk
# EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your-key

# Firebase
# EXPO_PUBLIC_FIREBASE_API_KEY=your-api-key
# EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
# EXPO_PUBLIC_FIREBASE_PROJECT_ID=your-project-id

# Little Guy talks to Gemini through supabase/functions/little-guy.
# When Supabase is configured, the app calls that function automatically.
# The Gemini key is a SERVER secret. Never put it in EXPO_PUBLIC_*.
#
# EXPO_PUBLIC_AI_API_URL=supabase
#
# On the server (Supabase secrets, not this file):
#   GEMINI_API_KEY=your-gemini-api-key
#   GEMINI_MODEL=gemini-2.5-flash-lite
